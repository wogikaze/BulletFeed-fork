BULLETFEED_GITHUB_CLIENT_ID=
BULLETFEED_GITHUB_CLIENT_SECRET=
BULLETFEED_GITHUB_WEBHOOK_SECRET=
BULLETFEED_GITHUB_CALLBACK_URL=http://127.0.0.1:8000/v1/auth/github/callback

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BULLETFEED_TOKEN_ENCRYPTION_KEY=

BULLETFEED_DATABASE_PATH=data/bulletfeed.db
BULLETFEED_ALLOWED_ORIGINS=http://localhost:3000

# Extra RSS hosts. Curated official topic feeds (Rust, LLVM, Kotlin, ...) are
# already allowed from the source seed list; this list is additive.
# Japanese community/index and company-tech-blog feeds are explicit as well;
# their authority is classified separately and is never inferred from RSS alone.
BULLETFEED_RSS_ALLOWED_HOSTS=blog.jetbrains.com,android-developers.googleblog.com,github.blog,blog.cloudflare.com,zenn.dev,qiita.com,b.hatena.ne.jp,yamadashy.github.io,techblog.lycorp.co.jp,engineering.mercari.com,developers.freee.co.jp,engineering.dena.com,techblog.zozo.com

# Local uvicorn embeds the source-sync worker so followed topics can fill the feed.
# Release compose sets this to 0 on the API container (dedicated worker process).
# BULLETFEED_EMBED_SOURCE_SYNC_WORKER=1
