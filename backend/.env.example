BULLETFEED_GITHUB_CLIENT_ID=
BULLETFEED_GITHUB_CLIENT_SECRET=
BULLETFEED_GITHUB_WEBHOOK_SECRET=
BULLETFEED_GITHUB_CALLBACK_URL=http://127.0.0.1:8000/v1/auth/github/callback

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BULLETFEED_TOKEN_ENCRYPTION_KEY=

BULLETFEED_DATABASE_PATH=data/bulletfeed.db
BULLETFEED_ALLOWED_ORIGINS=http://localhost:3000

# RSS fetching is disabled unless the host is explicitly listed here.
BULLETFEED_RSS_ALLOWED_HOSTS=blog.jetbrains.com,android-developers.googleblog.com,github.blog,blog.cloudflare.com
