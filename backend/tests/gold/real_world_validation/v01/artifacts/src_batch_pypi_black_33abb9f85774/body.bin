":"a5355cfb22a001e386ae6e22c4e33b20","sha256":"e825d6b121910dff6f04d7691f826d2449327e8e71c26254c030c4f3d2311985"},"downloads":-1,"filename":"black-26.3.0-py3-none-any.whl","has_sig":false,"md5_digest":"a5355cfb22a001e386ae6e22c4e33b20","packagetype":"bdist_wheel","python_version":"py3","requires_python":">=3.10","size":206848,"upload_time":"2026-03-06T17:42:31","upload_time_iso_8601":"2026-03-06T17:42:31.133686Z","url":"https://files.pythonhosted.org/packages/39/d7/7360654ba4f8b41afcaeb5aca973cfea5591da75aff79b0a8ae0bb8883f6/black-26.3.0-py3-none-any.whl","yanked":false,"yanked_reason":null},{"comment_text":null,"core-metadata":false,"digests":{"blake2b_256":"115f25b7b149b8b7d3b958efa4faa56446560408c0f2651108a517526de0320a","md5":"c01dce43efd71a7754ffd9cc3234fe89","sha256":"4d438dfdba1c807c6c7c63c4f15794dda0820d2222e7c4105042ac9ddfc5dd0b"},"downloads":-1,"filename":"black-26.3.0.tar.gz","has_sig":false,"md5_digest":"c01dce43efd71a7754ffd9cc3234fe89","packagetype":"sdist","python_version":"source","requires_python":">=3.10","size":664127,"upload_time":"2026-03-06T17:42:33","upload_time_iso_8601":"2026-03-06T17:42:33.700428Z","url":"https://files.pythonhosted.org/packages/11/5f/25b7b149b8b7d3b958efa4faa56446560408c0f2651108a517526de0320a/black-26.3.0.tar.gz","yanked":false,"yanked_reason":null}],"vulnerabilities":[{"aliases":["CVE-2026-32274","PYSEC-2026-2121"],"details":"### Impact\n\nBlack writes a cache file, the name of which is computed from various formatting options. The value of the `--python-cell-magics` option was placed in the filename without sanitization, which allowed an attacker who controls the value of this argument to write cache files to arbitrary file system locations. \n\n### Patches\n\nFixed in Black 26.3.1.\n\n### Workarounds\n\nDo not allow untrusted user input into the value of the `--python-cell-magics` option.","fixed_in":["26.3.1"],"id":"GHSA-3936-cmfr-pm3m","link":"https://osv.dev/vulnerability/GHSA-3936-cmfr-pm3m","source":"osv","summary":null,"withdrawn":null},{"aliases":["CVE-2026-32274","GHSA-3936-cmfr-pm3m"],"details":"Black is the uncompromising Python code formatter. Prior to 26.3.1, Black writes a cache file, the name of which is computed from various formatting options. The value of the --python-cell-magics option was placed in the filename without sanitization, which allowed an attacker who controls the value of this argument to write cache files to arbitrary file system locations. Fixed in Black 26.3.1.","fixed_in":["26.3.1"],"id":"PYSEC-2026-2121","link":"https://osv.dev/vulnerability/PYSEC-2026-2121","source":"osv","summary":null,"withdrawn":null}]}
