{"info":{"author":null,"author_email":"Jukka Lehtosalo <jukka.lehtosalo@iki.fi>","bugtrack_url":null,"classifiers":["Development Status :: 5 - Production/Stable","Environment :: Console","Intended Audience :: Developers","Programming Language :: Python :: 3","Programming Language :: Python :: 3.10","Programming Language :: Python :: 3.11","Programming Language :: Python :: 3.12","Programming Language :: Python :: 3.13","Programming Language :: Python :: 3.14","Programming Language :: Python :: 3.15","Topic :: Software Development","Typing :: Typed"],"description":"Mypy -- Optional Static Typing for Python\r\n=========================================\r\n\r\nAdd type annotations to your Python programs, and use mypy to type\r\ncheck them.  Mypy is essentially a Python linter on steroids, and it\r\ncan catch many programming errors by analyzing your program, without\r\nactually having to run it.  Mypy has a powerful type system with\r\nfeatures such as type inference, gradual typing, generics and union\r\ntypes.\r\n","description_content_type":"text/x-rst","docs_url":null,"download_url":null,"downloads":{"last_day":-1,"last_month":-1,"last_week":-1},"dynamic":["License-File"],"home_page":null,"keywords":null,"license":null,"license_expression":"MIT","license_files":["LICENSE","mypy/typeshed/LICENSE"],"maintainer":null,"maintainer_email":null,"name":"mypy","package_url":"https://pypi.org/project/mypy/","platform":null,"project_url":"https://pypi.org/project/mypy/","project_urls":{"Changelog":"https://github.com/python/mypy/blob/master/CHANGELOG.md","Documentation":"https://mypy.readthedocs.io/en/stable/index.html","Homepage":"https://www.mypy-lang.org/","Issues":"https://github.com/python/mypy/issues","Repository":"https://github.com/python/mypy"},"provides_extra":["dmypy","mypyc","reports","install-types","faster-cache","native-parser"],"release_url":"https://pypi.org/project/mypy/2.2.0/","requires_dist":["typing_extensions>=4.6.0; python_version < \"3.15\"","typing_extensions>=4.14.0; python_version >= \"3.15\"","mypy_extensions>=1.0.0","pathspec>=1.0.0","tomli>=1.1.0; python_version < \"3.11\"","librt>=0.12.0; platform_python_implementation != \"PyPy\"","ast-serialize<1.0.0,>=0.6.0","psutil>=4.0; extra == \"dmypy\"","setuptools>=50; extra == \"mypyc\"","lxml; extra == \"reports\"","pip; extra == \"install-types\"","orjson; extra == \"faster-cache\""],"requires_python":">=3.10","summary":"Optional static typing for Python","version":"2.2.0","yanked":false,"yanked_reason":null},"last_serial":40042695,"ownership":{"organization":null,"roles":[{"role":"Owner","user":"ambv"},{"role":"Owner","user":"guido"},{"role":"Owner","user":"ilevkivskyi"},{"role":"Owner","user":"jukkal"},{"role":"Maintainer","user":"esarp"},{"role":"Maintainer","user":"hauntsaninja"},{"role":"Maintainer","user":"jhance"},{"role":"Maintainer","user":"kevinrk29"},{"role":"Maintainer","user":"maxmurin"},{"role":"Maintainer","user":"stas314"},{"role":"Maintainer","user":"svalentin"},{"role":"Maintainer","user":"wesleywright"}]},"urls":[{"comment_text":null,"core-metadata":{"sha256":"3aa7b41ed97ad3f251a85cbc0e3d491de2337da00dc8d8f1efc0dfb0c4ec7726"},"digests":{"blake2b_256":"5ff1a818c375094e20a74ec51444cce6979cedd61d476f860c2f084ea8653bd2","md5":"ccecca38e9bb28187ab370745cc123fa","sha256":"97d21f3a1582ef30d0b77f9ca3ad88b4263f3c5aea9e7380cb5d7175160aec7e"},"downloads":-1,"filename":"mypy-2.2.0-cp310-cp310-macosx_10_9_x86_64.whl","has_sig":false,"md5_digest":"ccecca38e9bb28187ab370745cc123fa","packagetype":"bdist_wheel","python_version":"cp310","requires_python":">=3.10","size":14903842,"upload_time":"2026-07-08T01:33:27","upload_time_iso_8601":"2026-07-08T01:33:27.944919Z","url":"https://files.pythonhosted.org/packages/5f/f1/a818c375094e20a74ec51444cce6979cedd61d476f860c2f084ea8653bd2/mypy-2.2.0-cp310-cp310-macosx_10_9_x86_64.whl","yanked":false,"yanked_reason":null},{"comment_text":null,"core-metadata":{"sha256":"3aa7b41ed97ad3f251a85cbc0e3d491de2337da00dc8d8f1efc0d