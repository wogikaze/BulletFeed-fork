{"page":{"id":"kctbh9vrtdwd","name":"GitHub","url":"https://www.githubstatus.com","time_zone":"Etc/UTC","updated_at":"2026-08-30T14:13:58.119Z"},"incident":{"id":"vv9vvksmj4s9","name":"Several GPT models degraded","status":"resolved","created_at":"2026-07-25T09:42:28.889Z","updated_at":"2026-07-30T16:04:22.692Z","monitoring_at":"2026-07-25T10:04:39.601Z","resolved_at":"2026-07-25T10:11:16.738Z","impact":"major","shortlink":"https://stspg.io/vh0xxw69dr6v","started_at":"2026-07-25T09:42:28.883Z","page_id":"kctbh9vrtdwd","incident_updates":[{"id":"mdbnd8pr0vlq","status":"resolved","body":"On July 25, 2026, between 09:07 and 10:04 UTC, the GPT-5.2, GPT-5.3-Codex, GPT-5.4, GPT-5.4 Mini, GPT-5.6 Sol, GPT-5.6 Terra and GPT-5.6 Luna models experienced degraded availability in GitHub Copilot products and IDE surfaces. Requests to these models had an average failure rate of 5.6%. Other Copilot models remained available as alternatives.\u003cbr /\u003e\u003cbr /\u003eThe degradation was caused by an issue with an upstream model provider. Success rates returned to normal after the upstream issue was mitigated, and we continued monitoring before resolving the incident. We are working on improving the automated failover for the affected models to prevent similar incidents in the future.","incident_id":"vv9vvksmj4s9","created_at":"2026-07-25T10:11:16.738Z","updated_at":"2026-07-30T16:04:22.686Z","display_at":"2026-07-25T10:11:16.738Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"operational","new_status":"operational"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"smklsn309xg8","status":"monitoring","body":"The degradation affecting Copilot AI Model Providers has been mitigated. We are monitoring to ensure stability.","incident_id":"vv9vvksmj4s9","created_at":"2026-07-25T10:04:39.601Z","updated_at":"2026-07-25T10:04:39.601Z","display_at":"2026-07-25T10:04:39.601Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"partial_outage","new_status":"operational"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"2rz9vhwbkhff","status":"investigating","body":"We are experiencing degraded availability for the GPT-5.2, GPT-5.3-Codex, GPT-5.4, GPT-5.4 Mini, GPT-5.6 Sol, GPT-5.6 Terra, and GPT-5.6 Luna models in Copilot products and IDE surfaces. This is due to an issue with an upstream model provider. While we work with them to resolve the issue, we recommend choosing another model or selecting 'Auto' to continue using Copilot.","incident_id":"vv9vvksmj4s9","created_at":"2026-07-25T09:48:30.969Z","updated_at":"2026-07-25T09:48:30.969Z","display_at":"2026-07-25T09:48:30.969Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"partial_outage","new_status":"partial_outage"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"8ql04hwt1g1w","status":"investigating","body":"We are investigating reports of degraded availability for Copilot AI Model Providers","incident_id":"vv9vvksmj4s9","created_at":"2026-07-25T09:42:28.945Z","updated_at":"2026-07-25T09:42:28.945Z","display_at":"2026-07-25T09:42:28.945Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"operational","new_status":"partial_outage"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null}],"components":[{"id":"cnnb39dkkk82","name":"Copilot AI Model Providers","status":"operational","created_at":"2026-04-17T12:33:08.827Z","updated_at":"2026-08-27T12:12:58.358Z","position":12,"description":null,"showcase":true,"start_date":"2026-04-17","group_id":null,"page_id":"kctbh9vrtdwd","group":false,"only_show_if_degraded":false}],"reminder_intervals":null}}