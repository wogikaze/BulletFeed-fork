{"page":{"id":"kctbh9vrtdwd","name":"GitHub","url":"https://www.githubstatus.com","time_zone":"Etc/UTC","updated_at":"2026-08-30T14:13:58.119Z"},"incident":{"id":"wt3hjqcrczfg","name":"Elevated errors on Fable 5 due to upstream provider","status":"resolved","created_at":"2026-08-24T07:12:05.373Z","updated_at":"2026-08-27T14:51:10.616Z","monitoring_at":null,"resolved_at":"2026-08-24T07:58:41.636Z","impact":"major","shortlink":"https://stspg.io/4dz9rv14dz14","started_at":"2026-08-24T07:12:05.367Z","page_id":"kctbh9vrtdwd","incident_updates":[{"id":"h3vttprpg6xd","status":"resolved","body":"On August 24th, 2026, between approximately 06:35 and 07:25 UTC, the Copilot service experienced a degradation of the Claude Fable 5 model due to an issue with our upstream provider. Users encountered elevated error rates when using Claude Fable 5, with requests sometimes failing mid-response. No other models were impacted.\u003cbr /\u003e\u003cbr /\u003eThe issue was resolved by a mitigation put in place by our provider. GitHub is working with our provider to further improve the resiliency of the service to prevent similar incidents in the future.","incident_id":"wt3hjqcrczfg","created_at":"2026-08-24T07:58:41.636Z","updated_at":"2026-08-27T14:51:10.612Z","display_at":"2026-08-24T07:58:41.636Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"partial_outage","new_status":"operational"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"tlg6g9v8x3rv","status":"investigating","body":"We are experiencing degraded availability for the Fable model in Copilot products and IDE surfaces. This is due to an issue with the upstream model provider. While we work with them to resolve the issue, we recommend choosing another model or selecting 'Auto' to continue using Copilot.","incident_id":"wt3hjqcrczfg","created_at":"2026-08-24T07:12:33.362Z","updated_at":"2026-08-24T07:12:33.362Z","display_at":"2026-08-24T07:12:33.362Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"partial_outage","new_status":"partial_outage"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"9xmrbn3fgcqt","status":"investigating","body":"We are investigating reports of degraded availability for Copilot AI Model Providers","incident_id":"wt3hjqcrczfg","created_at":"2026-08-24T07:12:05.431Z","updated_at":"2026-08-24T07:12:05.431Z","display_at":"2026-08-24T07:12:05.431Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"operational","new_status":"partial_outage"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null}],"components":[{"id":"cnnb39dkkk82","name":"Copilot AI Model Providers","status":"operational","created_at":"2026-04-17T12:33:08.827Z","updated_at":"2026-08-27T12:12:58.358Z","position":12,"description":null,"showcase":true,"start_date":"2026-04-17","group_id":null,"page_id":"kctbh9vrtdwd","group":false,"only_show_if_degraded":false}],"reminder_intervals":null}}