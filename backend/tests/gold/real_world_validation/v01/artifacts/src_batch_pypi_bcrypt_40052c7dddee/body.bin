{"sha256":"c95d417cb948eae765572db778d6f30daeb60d211b52b956be52c1088e9401d2"},"digests":{"blake2b_256":"ec867134b9dae7cf0efa85671651341f6afa695857fae172615e960fb6a466fa","md5":"09535a56a8ff26c5432431226ad974e6","sha256":"c58b56cdfb03202b3bcc9fd8daee8e8e9b6d7e3163aa97c631dfcfcc24d36c86"},"downloads":-1,"filename":"bcrypt-5.0.0-cp313-cp313t-manylinux_2_28_aarch64.whl","has_sig":false,"md5_digest":"09535a56a8ff26c5432431226ad974e6","packagetype":"bdist_wheel","python_version":"cp313","requires_python":">=3.8","size":269793,"upload_time":"2025-09-25T19:49:09","upload_time_iso_8601":"2025-09-25T19:49:09.727173Z","url":"https://files.pythonhosted.org/packages/ec/86/7134b9dae7cf0efa85671651341f6afa695857fae172615e960fb6a466fa/bcrypt-5.0.0-cp313-cp313t-manylinux_2_28_aarch64.whl","yanked":false,"yanked_reason":null},{"comment_text":null,"core-metadata":{"sha256":"c95d417cb948eae765572db778d6f30daeb60d211b52b956be52c1088e9401d2"},"digests":{"blake2b_256":"cc826296688ac1b9e503d034e7d0614d56e80c5d1a08402ff856a4549cb59207","md5":"a3a6c1a9c069cdb9b22e353dc53c2950","sha256":"4bfd2a34de661f34d0bda43c3e4e79df586e4716ef401fe31ea39d69d581ef23"},"downloads":-1,"filename":"bcrypt-5.0.0-cp313-cp313t-manylinux_2_28_armv7l.manylinux_2_31_armv7l.whl","has_sig":false,"md5_digest":"a3a6c1a9c069cdb9b22e353dc53c2950","packagetype":"bdist_wheel","python_version":"cp313","requires_python":">=3.8","size":289930,"upload_time":"2025-09-25T19:49:11","upload_time_iso_8601":"2025-09-25T19:49:11.204112Z","url":"https://files.pythonhosted.org/packages/cc/82/6296688ac1b9e503d034e7d0614d56e80c5d1a08402ff856a4549cb59207/bcrypt-5.0.0-cp313-cp313t-manylinux_2_28_armv7l.manylinux_2_31_armv7l.whl","yanked":false,"yanked_reason":null},{"comment_text":null,"core-metadata":{"sha256":"c95d417cb948eae765572db778d6f30daeb60d211b52b956be52c1088e9401d2"},"digests":{"blake2b_256":"d118884a44aa47f2a3b88dd09bc05a1e40b57878ecd111d17e5bba6f09f8bb77","md5":"046ccb560620a80054e410498d32d85b","sha256":"ed2e1365e31fc73f1825fa8