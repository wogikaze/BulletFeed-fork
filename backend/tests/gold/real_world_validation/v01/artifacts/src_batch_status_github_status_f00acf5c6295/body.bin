{"page":{"id":"kctbh9vrtdwd","name":"GitHub","url":"https://www.githubstatus.com","time_zone":"Etc/UTC","updated_at":"2026-08-30T14:13:58.119Z"},"incident":{"id":"d35pngcy6sb9","name":"Disruption with some GitHub services","status":"resolved","created_at":"2026-07-16T09:13:51.604Z","updated_at":"2026-07-21T09:50:38.354Z","monitoring_at":"2026-07-16T09:30:47.310Z","resolved_at":"2026-07-16T12:20:56.418Z","impact":"critical","shortlink":"https://stspg.io/5c43kg01skdw","started_at":"2026-07-16T09:13:51.585Z","page_id":"kctbh9vrtdwd","incident_updates":[{"id":"fmg02pz6lb8p","status":"resolved","body":"On July 16, 2026, between 08:50 UTC and 09:50 UTC, the GitHub MCP Server’s web_search tool experienced elevated failures. The average error rate was 42% and peaked at 82% of requests to the tool. Other GitHub MCP Server tools were unaffected. This was caused by degradation at a downstream web search provider.\u003cbr /\u003e\u003cbr /\u003eThe incident was mitigated when the downstream provider recovered, after which we confirmed that the tool’s success rate had returned to normal.\u003cbr /\u003e\u003cbr /\u003eWe are improving the tool’s resilience and failure handling to reduce the customer impact and duration of similar incidents.","incident_id":"d35pngcy6sb9","created_at":"2026-07-16T12:20:56.418Z","updated_at":"2026-07-21T09:50:38.348Z","display_at":"2026-07-16T12:20:56.418Z","affected_components":null,"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"n04x38chj5p3","status":"monitoring","body":"The degradation has been mitigated. We are monitoring to ensure stability.","incident_id":"d35pngcy6sb9","created_at":"2026-07-16T10:17:11.365Z","updated_at":"2026-07-16T10:17:11.365Z","display_at":"2026-07-16T10:17:11.365Z","affected_components":null,"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"qcbtn8dd3w5z","status":"monitoring","body":"The degradation has been mitigated. We are monitoring to ensure stability.","incident_id":"d35pngcy6sb9","created_at":"2026-07-16T09:30:47.310Z","updated_at":"2026-07-16T09:30:47.310Z","display_at":"2026-07-16T09:30:47.310Z","affected_components":null,"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"xm6r7dqf82f2","status":"investigating","body":"We are investigating reports of impacted performance for some GitHub services.","incident_id":"d35pngcy6sb9","created_at":"2026-07-16T09:13:51.679Z","updated_at":"2026-07-16T09:13:51.679Z","display_at":"2026-07-16T09:13:51.679Z","affected_components":null,"deliver_notifications":true,"custom_tweet":null,"tweet_id":null}],"components":[],"reminder_intervals":null}}