{"page":{"id":"kctbh9vrtdwd","name":"GitHub","url":"https://www.githubstatus.com","time_zone":"Etc/UTC","updated_at":"2026-08-30T14:13:58.119Z"},"incident":{"id":"jxd617hfwfq8","name":"Incident with Pull Requests","status":"resolved","created_at":"2026-07-24T19:37:28.079Z","updated_at":"2026-07-29T19:49:41.102Z","monitoring_at":"2026-07-24T20:02:39.236Z","resolved_at":"2026-07-24T20:23:10.319Z","impact":"critical","shortlink":"https://stspg.io/sm1tp7kfm4vj","started_at":"2026-07-24T19:37:28.071Z","page_id":"kctbh9vrtdwd","incident_updates":[{"id":"h51gbgc5m5zz","status":"resolved","body":"Between July 24, 19:17 UTC and July 24, 20:02 UTC, users were unable to create pull requests due to a database schema change. In total, 113,930 pull request creation attempts were impacted across 50,904 users, with an average error rate of 1.75% and a maximum error rate of 2.25% for all requests to Pull Requests service. Existing pull requests and other GitHub functionality were not affected. The issue was resolved by reverting the change to the affected database, upon which pull request creation immediately resumed.\u003cbr /\u003e\u003cbr /\u003eThe root cause was related to a backfill workflow into the Vitess keyspace hosting Pull Request data. The backfill Vitess command encountered errors and increased VReplication lag, and the workflow was canceled at 19:17 UTC. The cancellation executed a misunderstood Vitess codepath that dropped the backing table to the target keyspace, leaving a non-existent reference that resulted in errors creating Pull Requests. The mitigation was executing a command to drop the vschema reference to the dropped table, allowing Pull Request creation to resume.\u003cbr /\u003e\u003cbr /\u003eWe are adding stronger pre-flight validation to our tooling to prevent similar issues and expanding lower-environment support to provide better test coverage end-to-end before promoting them to production. We're also fixing our backfill migration tooling to protect from this specific codepath.","incident_id":"jxd617hfwfq8","created_at":"2026-07-24T20:23:10.319Z","updated_at":"2026-07-29T19:49:41.096Z","display_at":"2026-07-24T20:23:10.319Z","affected_components":[{"code":"hhtssxt0f5v2","name":"Pull Requests","old_status":"operational","new_status":"operational"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"2g4t08c40dbr","status":"monitoring","body":"The degradation affecting Pull Requests has been mitigated. We are monitoring to ensure stability.","incident_id":"jxd617hfwfq8","created_at":"2026-07-24T20:02:39.236Z","updated_at":"2026-07-24T20:02:39.236Z","display_at":"2026-07-24T20:02:39.236Z","affected_components":[{"code":"hhtssxt0f5v2","name":"Pull Requests","old_status":"major_outage","new_status":"operational"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"sjf31xcqv9zn","status":"investigating","body":"We have applied a mitigation and are monitoring for recovery","incident_id":"jxd617hfwfq8","created_at":"2026-07-24T19:59:57.275Z","updated_at":"2026-07-24T19:59:57.275Z","display_at":"2026-07-24T19:59:57.275Z","affected_components":[{"code":"hhtssxt0f5v2","name":"Pull Requests","old_status":"major_outage","new_status":"major_outage"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"2zmhwpgd2kyc","status":"investigating","body":"Pull Requests is experiencing degraded availability. We are continuing to investigate.","incident_id":"jxd617hfwfq8","created_at":"2026-07-24T19:43:40.031Z","updated_at":"2026-07-24T19:43:40.031Z","display_at":"2026-07-24T19:43:40.031Z","affected_components":[{"code":"hhtssxt0f5v2","name":"Pull Requests","old_status":"degraded_performance","new_status":"major_outage"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"d2g87ttcmj6n","status":"investigating","body":"We are investigating errors creating pull requests","incident_id":"jxd617hfwfq8","created_at":"2026-07-24T19:40:45.691Z","updated_at":"2026-07-24T19:40:45.691Z","display_at":"2026-07-24T19:40:45.691Z","affected_components":[{"code":"hhtssxt0f5v2","name":"Pull Requests","old_status":"degraded_performance","new_status":"degraded_performance"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"x8wzbkbbfblq","status":"investigating","body":"We are investigating reports of degraded performance for Pull Requests","incident_id":"jxd617hfwfq8","created_at":"2026-07-24T19:37:28.159Z","updated_at":"2026-07-24T19:37:28.159Z","display_at":"2026-07-24T19:37:28.159Z","affected_components":[{"code":"hhtssxt0f5v2","name":"Pull Requests","old_status":"operational","new_status":"degraded_performance"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null}],"components":[{"id":"hhtssxt0f5v2","name":"Pull Requests","status":"operational","created_at":"2020-09-02T15:39:06.329Z","updated_at":"2026-08-27T00:26:05.938Z","position":6,"description":"Requests for Pull Requests on GitHub.com","showcase":true,"start_date":null,"group_id":null,"page_id":"kctbh9vrtdwd","group":false,"only_show_if_degraded":false}],"reminder_intervals":null}}