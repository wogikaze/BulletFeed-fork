{"page":{"id":"kctbh9vrtdwd","name":"GitHub","url":"https://www.githubstatus.com","time_zone":"Etc/UTC","updated_at":"2026-08-30T14:13:58.119Z"},"incident":{"id":"24t8gsgqx2qb","name":"Errors with the Fable 5 Model in Copilot","status":"resolved","created_at":"2026-08-13T14:43:25.203Z","updated_at":"2026-08-25T12:08:46.313Z","monitoring_at":null,"resolved_at":"2026-08-13T15:47:22.384Z","impact":"minor","shortlink":"https://stspg.io/8htrnxk0q09v","started_at":"2026-08-13T14:43:25.196Z","page_id":"kctbh9vrtdwd","incident_updates":[{"id":"7n5fhmltjghm","status":"resolved","body":"On August 13th, 2026, between approximately 14:06 and 15:47 UTC, the Copilot service experienced a degradation of the Claude Fable 5 model due to an issue with our upstream provider. Users encountered elevated error rates, peaking at 43% and averaging 12%. Users who selected Auto or alternative models were unaffected.\u003cbr /\u003e\u003cbr /\u003eThe issue was resolved by a mitigation put in place by our provider. GitHub is working with our provider to further improve the resiliency of the service to prevent similar incidents in the future.","incident_id":"24t8gsgqx2qb","created_at":"2026-08-13T15:47:22.384Z","updated_at":"2026-08-25T12:08:46.309Z","display_at":"2026-08-13T15:47:22.384Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"degraded_performance","new_status":"operational"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"16czhjwm8x58","status":"investigating","body":"The issues with our upstream model provider have been resolved, and Fable 5 is once again available in Copilot products and IDE surfaces.\u003cbr /\u003e\u003cbr /\u003eWe will continue monitoring to ensure stability, but mitigation is complete.","incident_id":"24t8gsgqx2qb","created_at":"2026-08-13T15:47:15.736Z","updated_at":"2026-08-13T15:47:15.736Z","display_at":"2026-08-13T15:47:15.736Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"degraded_performance","new_status":"degraded_performance"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"mnpr6hw95wf1","status":"investigating","body":"We are seeing modest recovery, but are still experiencing degraded availability for the Fable 5 model in Copilot products and IDE surfaces. This is due to an issue with an upstream model provider. While we work with them to resolve the issue, we recommend choosing another model or selecting 'Auto' to continue using Copilot.","incident_id":"24t8gsgqx2qb","created_at":"2026-08-13T15:23:39.378Z","updated_at":"2026-08-13T15:23:39.378Z","display_at":"2026-08-13T15:23:39.378Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"degraded_performance","new_status":"degraded_performance"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"n88by2bcx3wg","status":"investigating","body":"We are experiencing degraded availability for the Fable 5 model in Copilot products and IDE surfaces. This is due to an issue with an upstream model provider. While we work with them to resolve the issue, we recommend choosing another model or selecting 'Auto' to continue using Copilot.","incident_id":"24t8gsgqx2qb","created_at":"2026-08-13T14:50:10.040Z","updated_at":"2026-08-13T14:50:10.040Z","display_at":"2026-08-13T14:50:10.040Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"degraded_performance","new_status":"degraded_performance"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"b2whhtnz65dz","status":"investigating","body":"We are investigating reports of degraded performance for Copilot AI Model Providers","incident_id":"24t8gsgqx2qb","created_at":"2026-08-13T14:43:25.299Z","updated_at":"2026-08-13T14:43:25.299Z","display_at":"2026-08-13T14:43:25.299Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"operational","new_status":"degraded_performance"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null}],"components":[{"id":"cnnb39dkkk82","name":"Copilot AI Model Providers","status":"operational","created_at":"2026-04-17T12:33:08.827Z","updated_at":"2026-08-27T12:12:58.358Z","position":12,"description":null,"showcase":true,"start_date":"2026-04-17","group_id":null,"page_id":"kctbh9vrtdwd","group":false,"only_show_if_degraded":false}],"reminder_intervals":null}}