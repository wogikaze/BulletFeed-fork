{"page":{"id":"kctbh9vrtdwd","name":"GitHub","url":"https://www.githubstatus.com","time_zone":"Etc/UTC","updated_at":"2026-08-30T14:13:58.119Z"},"incident":{"id":"20frdtvv3yg6","name":"Disruption with actions hosted runners","status":"resolved","created_at":"2026-07-22T20:43:43.797Z","updated_at":"2026-07-24T23:09:42.211Z","monitoring_at":"2026-07-22T22:01:57.549Z","resolved_at":"2026-07-22T22:09:26.957Z","impact":"minor","shortlink":"https://stspg.io/hccgdw2k2b1q","started_at":"2026-07-22T20:43:43.789Z","page_id":"kctbh9vrtdwd","incident_updates":[{"id":"02zk52mdqsq8","status":"resolved","body":"On July 22, 2026, between 19:36 UTC and 22:04 UTC, GitHub Actions experienced delayed and failed job starts on GitHub-hosted runners. The incident was caused by an unhealthy state in a backend data service responsible for provisioning hosted runners, preventing runner acquisition for a subset of workloads. During most of the incident, approximately 15% of workflow runs on hosted runners were delayed by more than 5 minutes, while roughly 1% failed to start.\u003cbr /\u003e\u003cbr /\u003eAt 21:49 UTC, we restored the health of the backend data replication system, allowing provisioning to recover and the accumulated workflow backlog to drain. Service performance then returned to expected levels. We are improving provisioning-service resiliency, workload distribution, and capacity balancing to reduce the likelihood and impact of similar incidents.","incident_id":"20frdtvv3yg6","created_at":"2026-07-22T22:09:26.957Z","updated_at":"2026-07-24T23:09:42.206Z","display_at":"2026-07-22T22:09:26.957Z","affected_components":[{"code":"br0l2tvcx85d","name":"Actions","old_status":"operational","new_status":"operational"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"bbdq20tkd55c","status":"monitoring","body":"The degradation affecting Actions has been mitigated. We are monitoring to ensure stability.","incident_id":"20frdtvv3yg6","created_at":"2026-07-22T22:01:57.549Z","updated_at":"2026-07-22T22:01:57.549Z","display_at":"2026-07-22T22:01:57.549Z","affected_components":[{"code":"br0l2tvcx85d","name":"Actions","old_status":"degraded_performance","new_status":"operational"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"hsnkhygj7qpy","status":"investigating","body":"The degradation affecting Actions has been mitigated. We are monitoring to ensure stability.","incident_id":"20frdtvv3yg6","created_at":"2026-07-22T22:01:51.972Z","updated_at":"2026-07-22T22:01:51.972Z","display_at":"2026-07-22T22:01:51.972Z","affected_components":[{"code":"br0l2tvcx85d","name":"Actions","old_status":"degraded_performance","new_status":"degraded_performance"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"70q12wmx3ckx","status":"investigating","body":"Approximately 3% of GitHub Actions runs on GitHub-hosted runners are experiencing run start delays exceeding 5 minutes. A small portion of these runs may fail after extended delays. We have identified the cause and are working on a mitigation.","incident_id":"20frdtvv3yg6","created_at":"2026-07-22T20:47:02.375Z","updated_at":"2026-07-22T20:47:02.375Z","display_at":"2026-07-22T20:47:02.375Z","affected_components":[{"code":"br0l2tvcx85d","name":"Actions","old_status":"degraded_performance","new_status":"degraded_performance"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"0nkb28qlrqrw","status":"investigating","body":"We are investigating reports of degraded performance for Actions","incident_id":"20frdtvv3yg6","created_at":"2026-07-22T20:43:43.871Z","updated_at":"2026-07-22T20:43:43.871Z","display_at":"2026-07-22T20:43:43.871Z","affected_components":[{"code":"br0l2tvcx85d","name":"Actions","old_status":"operational","new_status":"degraded_performance"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null}],"components":[{"id":"br0l2tvcx85d","name":"Actions","status":"operational","created_at":"2019-11-13T18:02:19.432Z","updated_at":"2026-08-27T00:26:05.957Z","position":7,"description":"Workflows, Compute and Orchestration for GitHub Actions","showcase":true,"start_date":null,"group_id":null,"page_id":"kctbh9vrtdwd","group":false,"only_show_if_degraded":false}],"reminder_intervals":null}}