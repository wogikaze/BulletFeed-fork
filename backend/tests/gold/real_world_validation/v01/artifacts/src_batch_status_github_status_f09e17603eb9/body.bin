{"page":{"id":"kctbh9vrtdwd","name":"GitHub","url":"https://www.githubstatus.com","time_zone":"Etc/UTC","updated_at":"2026-08-30T14:13:58.119Z"},"incident":{"id":"kk183dslzdzd","name":"Degraded availability GPT 5.6 Luna","status":"resolved","created_at":"2026-08-01T11:16:25.356Z","updated_at":"2026-08-11T06:56:18.813Z","monitoring_at":null,"resolved_at":"2026-08-01T12:30:21.775Z","impact":"minor","shortlink":"https://stspg.io/pj5lgggbc2rb","started_at":"2026-08-01T11:16:25.348Z","page_id":"kctbh9vrtdwd","incident_updates":[{"id":"fydnbprsl5lq","status":"resolved","body":"On August 1st, 2026, the GPT-5.6 Luna model in GitHub Copilot experienced degraded availability in intermittent time intervals between ~08:05 UTC and ~16:30 UTC. Specifically the timeframes observed were 10:00-10:20 UTC, 10:45-11:50 UTC, 13:00-14:25 UTC, and 16:00-16:30 UTC. During this time, requests to GPT-5.6 Luna in Copilot chat and IDE surfaces frequently failed or timed out. This was caused by an issue with an upstream model provider. Other Copilot models were not affected, and users could continue working by selecting another model or 'Auto'. Availability for GPT-5.6 Luna fully recovered once the provider resolved their outage at 16:30 UTC.","incident_id":"kk183dslzdzd","created_at":"2026-08-01T12:30:21.775Z","updated_at":"2026-08-11T06:56:18.810Z","display_at":"2026-08-01T12:30:21.775Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"degraded_performance","new_status":"operational"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"ns4jqhby5dq0","status":"investigating","body":"The issues with our upstream model provider have been resolved, and GPT-5.6 Luna is once again available in Copilot products and IDE surfaces.\u003cbr /\u003eWe will continue monitoring to ensure stability, but mitigation is complete.","incident_id":"kk183dslzdzd","created_at":"2026-08-01T12:29:20.237Z","updated_at":"2026-08-01T12:29:20.237Z","display_at":"2026-08-01T12:29:20.237Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"degraded_performance","new_status":"degraded_performance"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"lzyhhxvf86s1","status":"investigating","body":"We keep working with our upstream model provider, and are observing recovery. We continue monitoring to ensure stability.","incident_id":"kk183dslzdzd","created_at":"2026-08-01T12:13:24.248Z","updated_at":"2026-08-01T12:13:24.248Z","display_at":"2026-08-01T12:13:24.248Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"degraded_performance","new_status":"degraded_performance"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"kstwh8y5g74p","status":"investigating","body":"We are experiencing degraded availability for the GPT-5.6 Luna model in Copilot products and IDE surfaces. This is due to an issue with an upstream model provider. While we work with them to resolve the issue, we recommend choosing another model or selecting 'Auto' to continue using Copilot","incident_id":"kk183dslzdzd","created_at":"2026-08-01T11:20:02.543Z","updated_at":"2026-08-01T11:20:02.543Z","display_at":"2026-08-01T11:20:02.543Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"degraded_performance","new_status":"degraded_performance"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"rg7ycrsx36rz","status":"investigating","body":"We are investigating reports of degraded performance for Copilot AI Model Providers","incident_id":"kk183dslzdzd","created_at":"2026-08-01T11:16:25.435Z","updated_at":"2026-08-01T11:16:25.435Z","display_at":"2026-08-01T11:16:25.435Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"operational","new_status":"degraded_performance"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null}],"components":[{"id":"cnnb39dkkk82","name":"Copilot AI Model Providers","status":"operational","created_at":"2026-04-17T12:33:08.827Z","updated_at":"2026-08-27T12:12:58.358Z","position":12,"description":null,"showcase":true,"start_date":"2026-04-17","group_id":null,"page_id":"kctbh9vrtdwd","group":false,"only_show_if_degraded":false}],"reminder_intervals":null}}