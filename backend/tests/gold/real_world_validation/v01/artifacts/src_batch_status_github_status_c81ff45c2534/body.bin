{"page":{"id":"kctbh9vrtdwd","name":"GitHub","url":"https://www.githubstatus.com","time_zone":"Etc/UTC","updated_at":"2026-08-30T14:13:58.119Z"},"incident":{"id":"sj1tzyrx599x","name":"Incident with Copilot AI Model Providers","status":"resolved","created_at":"2026-08-01T18:03:05.539Z","updated_at":"2026-08-12T16:18:09.791Z","monitoring_at":"2026-08-01T18:20:48.941Z","resolved_at":"2026-08-01T18:44:28.733Z","impact":"minor","shortlink":"https://stspg.io/z58g1g529hzz","started_at":"2026-08-01T18:03:05.531Z","page_id":"kctbh9vrtdwd","incident_updates":[{"id":"zfj67r3cm6rq","status":"resolved","body":"On August 1, 2026, between 17:47 UTC and 18:20 UTC, users of the Fable 5 model in GitHub Copilot experienced increased request failures and latency. The average failure rate across all Copilot requests was 0.007%, while failures for Fable 5 peaked at 5.6%. Other models remained available. This was caused by degradation of an upstream model provider.\u003cbr /\u003e\u003cbr /\u003eThe affected endpoint recovered, and we monitored the service until error rates and latency returned to normal levels. We are working to add endpoint redundancy to mitigate similar provider issues in the future.","incident_id":"sj1tzyrx599x","created_at":"2026-08-01T18:44:28.733Z","updated_at":"2026-08-12T16:18:09.786Z","display_at":"2026-08-01T18:44:28.733Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"operational","new_status":"operational"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"qh1zlp9xz3fm","status":"monitoring","body":"The issues with our upstream model provider have been resolved, and Fable 5 is once again available in Copilot products and IDE surfaces.\u003cbr /\u003e\u003cbr /\u003eWe will continue monitoring to ensure stability, but mitigation is complete.","incident_id":"sj1tzyrx599x","created_at":"2026-08-01T18:23:40.021Z","updated_at":"2026-08-01T18:23:40.021Z","display_at":"2026-08-01T18:23:40.021Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"operational","new_status":"operational"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"q1v2bhz3pc36","status":"monitoring","body":"The degradation affecting Copilot AI Model Providers has been mitigated. We are monitoring to ensure stability.","incident_id":"sj1tzyrx599x","created_at":"2026-08-01T18:20:48.941Z","updated_at":"2026-08-01T18:20:48.941Z","display_at":"2026-08-01T18:20:48.941Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"degraded_performance","new_status":"operational"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"gh4nm8yh653k","status":"investigating","body":"We are experiencing degraded availability for the Fable 5 model in Copilot products and IDE surfaces. This is due to an issue with an upstream model provider. While we work with them to resolve the issue, we recommend choosing another model or selecting 'Auto' to continue using Copilot.","incident_id":"sj1tzyrx599x","created_at":"2026-08-01T18:20:20.807Z","updated_at":"2026-08-01T18:20:20.807Z","display_at":"2026-08-01T18:20:20.807Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"degraded_performance","new_status":"degraded_performance"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"38y461sny38x","status":"investigating","body":"We are seeing increased error rates from specific upstream AI Model Providers","incident_id":"sj1tzyrx599x","created_at":"2026-08-01T18:03:15.483Z","updated_at":"2026-08-01T18:03:15.483Z","display_at":"2026-08-01T18:03:15.483Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"degraded_performance","new_status":"degraded_performance"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"whdtrmj4k5y1","status":"investigating","body":"We are investigating reports of degraded performance for Copilot AI Model Providers","incident_id":"sj1tzyrx599x","created_at":"2026-08-01T18:03:05.616Z","updated_at":"2026-08-01T18:03:05.616Z","display_at":"2026-08-01T18:03:05.616Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"operational","new_status":"degraded_performance"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null}],"components":[{"id":"cnnb39dkkk82","name":"Copilot AI Model Providers","status":"operational","created_at":"2026-04-17T12:33:08.827Z","updated_at":"2026-08-27T12:12:58.358Z","position":12,"description":null,"showcase":true,"start_date":"2026-04-17","group_id":null,"page_id":"kctbh9vrtdwd","group":false,"only_show_if_degraded":false}],"reminder_intervals":null}}