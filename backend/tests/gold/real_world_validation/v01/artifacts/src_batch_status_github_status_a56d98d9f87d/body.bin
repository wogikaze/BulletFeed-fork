{"page":{"id":"kctbh9vrtdwd","name":"GitHub","url":"https://www.githubstatus.com","time_zone":"Etc/UTC","updated_at":"2026-08-30T14:13:58.119Z"},"incident":{"id":"594m87r8sw13","name":"Incident With Blocked GitHub.com Traffic","status":"resolved","created_at":"2026-07-24T11:00:00.000Z","updated_at":"2026-07-24T15:56:48.891Z","monitoring_at":null,"resolved_at":"2026-07-24T11:00:00.000Z","impact":"none","shortlink":"https://stspg.io/dd1j7wg77hn9","started_at":"2026-07-24T15:56:48.829Z","page_id":"kctbh9vrtdwd","incident_updates":[{"id":"4vz29my0d0gw","status":"resolved","body":"Between July 23, 2026 at 18:45 UTC and July 24, 2026 at 11:19 UTC, an abuse mitigation update caused some legitimate customers whose traffic was routed through our Central Europe and South America edge locations to be incorrectly blocked from GitHub.com. We estimate that approximately 0.25% of GitHub.com requests were affected during this period.\n\nThis was caused by an abuse mitigation configuration that incorrectly classified legitimate traffic. We mitigated the incident by reverting the update. We are adding validation and safeguards to prevent similar incorrect blocking in the future.","incident_id":"594m87r8sw13","created_at":"2026-07-24T15:56:48.881Z","updated_at":"2026-07-24T15:56:48.881Z","display_at":"2026-07-24T11:00:00.000Z","affected_components":null,"deliver_notifications":false,"custom_tweet":null,"tweet_id":null}],"components":[],"reminder_intervals":null}}