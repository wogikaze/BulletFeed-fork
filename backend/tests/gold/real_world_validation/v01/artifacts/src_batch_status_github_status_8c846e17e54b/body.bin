{"page":{"id":"kctbh9vrtdwd","name":"GitHub","url":"https://www.githubstatus.com","time_zone":"Etc/UTC","updated_at":"2026-08-30T14:13:58.119Z"},"incident":{"id":"9tpgqq1h4bs7","name":"Copilot model Claude Fable 5 experiencing elevated errors","status":"resolved","created_at":"2026-07-30T09:07:42.419Z","updated_at":"2026-08-04T16:34:28.851Z","monitoring_at":null,"resolved_at":"2026-07-30T10:12:15.489Z","impact":"minor","shortlink":"https://stspg.io/45g8r57kv3n9","started_at":"2026-07-30T09:07:42.413Z","page_id":"kctbh9vrtdwd","incident_updates":[{"id":"7f4jmtk5hldk","status":"resolved","body":"On July 30, 2026, the Claude Fable 5 model in GitHub Copilot experienced degraded availability for approximately 73 minutes, from 08:33 to 09:46 UTC. During this time, requests to Claude Fable 5 in Copilot chat and IDE surfaces frequently failed or timed out. This was caused by an issue with an upstream model provider. Other Copilot models were not affected, and users could continue working by selecting another model or 'Auto'. Availability for Claude Fable 5 fully recovered once the provider resolved their outage at 09:46 UTC, and we confirmed resolution at 10:12 UTC.","incident_id":"9tpgqq1h4bs7","created_at":"2026-07-30T10:12:15.489Z","updated_at":"2026-08-04T16:34:28.845Z","display_at":"2026-07-30T10:12:15.489Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"degraded_performance","new_status":"operational"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"037n83zvm9h2","status":"investigating","body":"The issues with our upstream model provider have been resolved, and Claude Fable 5 is once again available in Copilot products and IDE surfaces.\u003cbr /\u003e\u003cbr /\u003eWe will continue monitoring to ensure stability, but mitigation is complete.","incident_id":"9tpgqq1h4bs7","created_at":"2026-07-30T10:11:55.043Z","updated_at":"2026-07-30T10:11:55.043Z","display_at":"2026-07-30T10:11:55.043Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"degraded_performance","new_status":"degraded_performance"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"kdqcg22bx7g4","status":"investigating","body":"We are experiencing degraded availability for the Claude Fable 5 model in Copilot products and IDE surfaces. This is due to an issue with an upstream model provider. While we work with them to resolve the issue, we recommend choosing another model or selecting 'Auto' to continue using Copilot.","incident_id":"9tpgqq1h4bs7","created_at":"2026-07-30T09:17:26.637Z","updated_at":"2026-07-30T09:17:26.637Z","display_at":"2026-07-30T09:17:26.637Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"degraded_performance","new_status":"degraded_performance"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"0fwv1y51nm9q","status":"investigating","body":"We are investigating reports of degraded performance for Copilot AI Model Providers","incident_id":"9tpgqq1h4bs7","created_at":"2026-07-30T09:07:42.478Z","updated_at":"2026-07-30T09:07:42.478Z","display_at":"2026-07-30T09:07:42.478Z","affected_components":[{"code":"cnnb39dkkk82","name":"Copilot AI Model Providers","old_status":"operational","new_status":"degraded_performance"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null}],"components":[{"id":"cnnb39dkkk82","name":"Copilot AI Model Providers","status":"operational","created_at":"2026-04-17T12:33:08.827Z","updated_at":"2026-08-27T12:12:58.358Z","position":12,"description":null,"showcase":true,"start_date":"2026-04-17","group_id":null,"page_id":"kctbh9vrtdwd","group":false,"only_show_if_degraded":false}],"reminder_intervals":null}}