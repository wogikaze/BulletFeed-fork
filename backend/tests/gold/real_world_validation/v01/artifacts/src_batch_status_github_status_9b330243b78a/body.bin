{"page":{"id":"kctbh9vrtdwd","name":"GitHub","url":"https://www.githubstatus.com","time_zone":"Etc/UTC","updated_at":"2026-08-30T14:13:58.119Z"},"incident":{"id":"76t89hbfb09h","name":"Incident with Pull Requests and Issues","status":"resolved","created_at":"2026-08-12T16:16:18.003Z","updated_at":"2026-08-18T15:52:05.294Z","monitoring_at":"2026-08-12T16:35:40.052Z","resolved_at":"2026-08-12T16:41:18.768Z","impact":"minor","shortlink":"https://stspg.io/ssd9z8l2g46v","started_at":"2026-08-12T16:16:17.994Z","page_id":"kctbh9vrtdwd","incident_updates":[{"id":"7xm3qnfwmw42","status":"resolved","body":"Between 16:03 and 16:29 UTC on August 12, some users encountered errors when viewing pull requests, issues, and search results. During this period, about 1.9% of Pull Request requests and 0.9% of Issues requests failed. During a database migration, two indexes were removed while application settings still referenced them, causing affected requests to fail. We detected the issue after the migration reached one database shard and before it progressed to the remaining shards. We restored service by disabling both settings. We are improving safeguards around database migrations and application configuration to prevent similar mismatches from causing errors.","incident_id":"76t89hbfb09h","created_at":"2026-08-12T16:41:18.768Z","updated_at":"2026-08-18T15:52:05.288Z","display_at":"2026-08-12T16:41:18.768Z","affected_components":[{"code":"kr09ddfgbfsf","name":"Issues","old_status":"operational","new_status":"operational"},{"code":"hhtssxt0f5v2","name":"Pull Requests","old_status":"operational","new_status":"operational"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"8j3lvjyw8nwr","status":"monitoring","body":"We identified the source of errors affecting Pull Requests, Issues, and Search on GitHub.com and have applied a mitigation. A database index hint was referencing an index that had been removed by a recent migration, causing query failures for some users. We disabled the problematic configuration and are seeing recovery across affected services. We are continuing to monitor to confirm full resolution.","incident_id":"76t89hbfb09h","created_at":"2026-08-12T16:38:38.345Z","updated_at":"2026-08-12T16:38:38.345Z","display_at":"2026-08-12T16:38:38.345Z","affected_components":[{"code":"kr09ddfgbfsf","name":"Issues","old_status":"operational","new_status":"operational"},{"code":"hhtssxt0f5v2","name":"Pull Requests","old_status":"operational","new_status":"operational"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"ylfmpf85g5vc","status":"monitoring","body":"The degradation affecting Issues and Pull Requests has been mitigated. We are monitoring to ensure stability.","incident_id":"76t89hbfb09h","created_at":"2026-08-12T16:35:40.052Z","updated_at":"2026-08-12T16:35:40.052Z","display_at":"2026-08-12T16:35:40.052Z","affected_components":[{"code":"kr09ddfgbfsf","name":"Issues","old_status":"degraded_performance","new_status":"operational"},{"code":"hhtssxt0f5v2","name":"Pull Requests","old_status":"degraded_performance","new_status":"operational"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"w3gj6z2ds19t","status":"investigating","body":"We are investigating reports of errors affecting Pull Requests and Issues on GitHub.com. Some users may encounter 500 errors when loading pull request and issue pages. Our engineering teams are actively investigating the root cause, which appears to be related to a database infrastructure issue. We will provide an update as soon as we have more information.","incident_id":"76t89hbfb09h","created_at":"2026-08-12T16:24:30.991Z","updated_at":"2026-08-12T16:24:30.991Z","display_at":"2026-08-12T16:24:30.991Z","affected_components":[{"code":"kr09ddfgbfsf","name":"Issues","old_status":"degraded_performance","new_status":"degraded_performance"},{"code":"hhtssxt0f5v2","name":"Pull Requests","old_status":"degraded_performance","new_status":"degraded_performance"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null},{"id":"cwlpjmhw2nk8","status":"investigating","body":"We are investigating reports of degraded performance for Issues and Pull Requests","incident_id":"76t89hbfb09h","created_at":"2026-08-12T16:16:18.105Z","updated_at":"2026-08-12T16:16:18.105Z","display_at":"2026-08-12T16:16:18.105Z","affected_components":[{"code":"kr09ddfgbfsf","name":"Issues","old_status":"operational","new_status":"degraded_performance"},{"code":"hhtssxt0f5v2","name":"Pull Requests","old_status":"operational","new_status":"degraded_performance"}],"deliver_notifications":true,"custom_tweet":null,"tweet_id":null}],"components":[{"id":"kr09ddfgbfsf","name":"Issues","status":"operational","created_at":"2017-01-31T20:01:46.638Z","updated_at":"2026-08-17T20:22:28.767Z","position":5,"description":"Requests for Issues on GitHub.com","showcase":true,"start_date":null,"group_id":null,"page_id":"kctbh9vrtdwd","group":false,"only_show_if_degraded":false},{"id":"hhtssxt0f5v2","name":"Pull Requests","status":"operational","created_at":"2020-09-02T15:39:06.329Z","updated_at":"2026-08-27T00:26:05.938Z","position":6,"description":"Requests for Pull Requests on GitHub.com","showcase":true,"start_date":null,"group_id":null,"page_id":"kctbh9vrtdwd","group":false,"only_show_if_degraded":false}],"reminder_intervals":null}}