{"info":{"author":null,"author_email":"Jukka Lehtosalo <jukka.lehtosalo@iki.fi>","bugtrack_url":null,"classifiers":["Development Status :: 5 - Production/Stable","Environment :: Console","Intended Audience :: Developers","Programming Language :: Python :: 3","Programming Language :: Python :: 3.10","Programming Language :: Python :: 3.11","Programming Language :: Python :: 3.12","Programming Language :: Python :: 3.13","Programming Language :: Python :: 3.14","Topic :: Software Development","Typing :: Typed"],"description":"Mypy -- Optional Static Typing for Python\n=========================================\n\nAdd type annotations to your Python programs, and use mypy to type\ncheck them.  Mypy is essentially a Python linter on steroids, and it\ncan catch many programming errors by analyzing your program, without\nactually having to run it.  Mypy has a powerful type system with\nfeatures such as type inference, gradual typing, generics and union\ntypes.\n","description_content_type":"text/x-rst","docs_url":null,"download_url":null,"downloads":{"last_day":-1,"last_month":-1,"last_week":-1},"dynamic":["License-File"],"home_page":null,"keywords":null,"license":null,"license_expression":"MIT","license_files":["LICENSE","mypy/typeshed/LICENSE"],"maintainer":null,"maintainer_email":null,"name":"mypy","package_url":"https://pypi.org/project/mypy/","platform":null,"project_url":"https://pypi.org/project/mypy/","project_urls":{"Changelog":"https://github.com/python/mypy/blob/master/CHANGELOG.md","Documentation":"https://mypy.readthedocs.io/en/stable/index.html","Homepage":"https://www.mypy-lang.org/","Issues":"https://github.com/python/mypy/issues","Repository":"https://github.com/python/mypy"},"provides_extra":["dmypy","mypyc","reports","install-types","faster-cache","native-parser"],"release_url":"https://pypi.org/project/mypy/2.0.0/","requires_dist":["typing_extensions>=4.6.0; python_version < \"3.15\"","typing_extensions>=4.14.0; python_version >= \"3.15\"","mypy_extensions>=1.0.0","pathspec>=1.0.0","tomli>=1.1.0; python_version < \"3.11\"","librt>=0.10.0; platform_python_implementation != \"PyPy\"","ast-serialize<1.0.0,>=0.3.0","psutil>=4.0; extra == \"dmypy\"","setuptools>=50; extra == \"mypyc\"","lxml; extra == \"reports\"","pip; extra == \"install-types\"","orjson; extra == \"faster-cache\""],"requires_python":">=3.10","summary":"Optional static typing for Python","version":"2.0.0","yanked":false,"yanked_reason":null},"last_serial":40042695,"ownership":{"organization":null,"roles":[{"role":"Owner","user":"ambv"},{"role":"Owner","user":"guido"},{"role":"Owner","user":"ilevkivskyi"},{"role":"Owner","user":"jukkal"},{"role":"Maintainer","user":"esarp"},{"role":"Maintainer","user":"hauntsaninja"},{"role":"Maintainer","user":"jhance"},{"role":"Maintainer","user":"kevinrk29"},{"role":"Maintainer","user":"maxmurin"},{"role":"Maintainer","user":"stas314"},{"role":"Maintainer","user":"svalentin"},{"role":"Maintainer","user":"wesleywright"}]},"urls":[{"comment_text":null,"core-metadata":{"sha256":"917c412679c22b9470049f4a4b2feddb9dfc64c35071ef7c0f337fc4309b26b5"},"digests":{"blake2b_256":"491e9983d2d5b5d2dc3677177bcf0fa6b25185ecf750cc0559e02199625a31c5","md5":"ea02c87bd9167890daba2ed191e4b167","sha256":"65d6f22d643bccaeb182d41d2a9f0990a05a871673c4ae3f97d4931eca0d2294"},"downloads":-1,"filename":"mypy-2.0.0-cp310-cp310-macosx_10_9_x86_64.whl","has_sig":false,"md5_digest":"ea02c87bd9167890daba2ed191e4b167","packagetype":"bdist_wheel","python_version":"cp310","requires_python":">=3.10","size":14663140,"upload_time":"2026-05-06T19:25:59","upload_time_iso_8601":"2026-05-06T19:25:59.474952Z","url":"https://files.pythonhosted.org/packages/49/1e/9983d2d5b5d2dc3677177bcf0fa6b25185ecf750cc0559e02199625a31c5/mypy-2.0.0-cp310-cp310-macosx_10_9_x86_64.whl","yanked":false,"yanked_reason":null},{"comment_text":null,"core-metadata":{"sha256":"917c412679c22b9470049f4a4b2feddb9dfc64c35071ef7c0f337fc4309b26b5"},"digests":{"blake2b_256":"69bcb4009c91d3ced13