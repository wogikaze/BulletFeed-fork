  "contract_version": "real-world-validation-contract-v1.1",
  "label_protocol_version": "label-protocol-v1",
  "required_source_fields": [
    "source_id",
    "canonical_url",
    "publisher",
    "source_family",
    "information_type",
    "language",
    "collected_at",
