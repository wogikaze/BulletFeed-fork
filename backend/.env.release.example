# Copy to .env.release on the deployment host. Never commit real secrets.
BULLETFEED_GITHUB_CLIENT_ID=
BULLETFEED_GITHUB_CLIENT_SECRET=
BULLETFEED_GITHUB_CALLBACK_URL=https://api.example.com/v1/auth/github/callback
BULLETFEED_TOKEN_ENCRYPTION_KEY=
BULLETFEED_DATABASE_PATH=/data/bulletfeed.db
BULLETFEED_ALLOWED_ORIGINS=
BULLETFEED_RSS_ALLOWED_HOSTS=
BULLETFEED_REQUEST_TIMEOUT_SECONDS=10
BULLETFEED_MAX_RESPONSE_BYTES=1048576
BULLETFEED_WORKER_IDLE_SECONDS=5
BULLETFEED_WORKER_POLL_SECONDS=300
BULLETFEED_WORKER_BATCH_SIZE=20
BULLETFEED_WORKER_HEALTH_MAX_AGE_SECONDS=30
BULLETFEED_BACKUP_RETENTION_DAYS=14
BULLETFEED_SNAPSHOT_DIR=/snapshots
BULLETFEED_CRAWLER_USER_AGENT=BulletFeed/1.0 (+https://github.com/wogikaze/BulletFeed-fork; source-watch)
